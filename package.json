{
  "name": "hi-tts",
  "version": "0.1.3",
  "description": "Hi-TTS • TTS ElevenLabs pour rewards Twitch en desktop.",
  "author": "Hiarte <contact@hiarte.fr>",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev:ui": "vite --port 55510",
    "dev:electron": "wait-on http://localhost:55510 && electron .",
    "dev": "concurrently \"npm:dev:ui\" \"npm:dev:electron\"",
    "build:ui": "vite build",
    "build:electron": "npm run build:ui && electron-builder",
    "build": "npm run build:electron",
    "preview": "vite preview --port 55510"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "express": "^4.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "concurrently": "^8.2.0",
    "electron": "^39.8.8",
    "electron-builder": "^26.8.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "esbuild": ">=0.24.3"
  },
  "build": {
    "appId": "com.hi-tts.app",
    "productName": "Hi-TTS",
    "artifactName": "Hi-TTS-Setup-${version}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "public/logos/hi-tts-task.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "public/logos/hi-tts-task.ico",
      "uninstallerIcon": "public/logos/hi-tts-task.ico",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  },
  "config": {
    "port": "55510"
  }
}
